Algoritmo tresnumeros
	Definir numro1, numro2, numro3 Como Entero
	Escribir "Ingrese el numero 1"
	Leer numro1
	Escribir "Ingrese el numero 2"
	Leer numro2
	Escribir "Ingrese el numero 3"
	Leer numro3 
	Si numro1 > numro2 Y numro1 > numro3 Entonces
        Escribir "El numero mayor es: ", numro1
    FinSi
    Si numro2 > numro1 Y numro2 > numro3 Entonces
        Escribir "El numero mayor es: ", numro2
    FinSi
    Si numro3 > numro1 Y numro3 > numro2 Entonces
        Escribir "El numero mayor es: ", numro3
    FinSi
FinAlgoritmo
